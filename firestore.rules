rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(category) {
      return category in ['STUDY', 'READING', 'CREATIVE', 'PLAY', 'CHORES', 'REST'];
    }

    function isValidRoutineItem(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 60 &&
             data.category is string &&
             isValidCategory(data.category) &&
             data.subjectId is string &&
             data.subjectId.size() <= 40 &&
             data.startMinutes is int &&
             data.startMinutes >= 0 &&
             data.startMinutes <= 1439 &&
             data.durationMinutes is int &&
             data.durationMinutes >= 5 &&
             data.durationMinutes <= 480 &&
             data.daysOfWeek is list &&
             data.daysOfWeek.size() >= 1 &&
             data.daysOfWeek.size() <= 7 &&
             data.daysOfWeek[0] is int &&
             data.daysOfWeek[0] >= 1 &&
             data.daysOfWeek[0] <= 7 &&
             data.note is string &&
             data.note.size() <= 160 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidRoutineLog(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.routineId is string &&
             isValidId(data.routineId) &&
             data.dateKey is string &&
             data.dateKey.size() == 10 &&
             data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.completed is bool &&
             data.starsEarned is int &&
             data.starsEarned >= 0 &&
             data.starsEarned <= 20 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidLessonProgress(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.subjectId is string &&
             data.subjectId.size() >= 1 &&
             data.subjectId.size() <= 40 &&
             data.lessonId is string &&
             isValidId(data.lessonId) &&
             data.completed is bool &&
             data.bestScore is int &&
             data.bestScore >= 0 &&
             data.bestScore <= 10 &&
             data.totalQuestions is int &&
             data.totalQuestions >= 1 &&
             data.totalQuestions <= 10 &&
             data.starsEarned is int &&
             data.starsEarned >= 0 &&
             data.starsEarned <= 50 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      match /routines/{routineId} {
        allow get: if isOwner(userId) && isValidId(routineId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(routineId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'category', 'subjectId',
                           'startMinutes', 'durationMinutes', 'daysOfWeek',
                           'note', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'category', 'subjectId',
                           'startMinutes', 'durationMinutes', 'daysOfWeek',
                           'note', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidRoutineItem(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(routineId) &&
                         isValidRoutineItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'category', 'subjectId', 'startMinutes',
                           'durationMinutes', 'daysOfWeek', 'note', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(routineId);
      }

      match /routineLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll([
                           'userId', 'routineId', 'dateKey',
                           'completed', 'starsEarned', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'routineId', 'dateKey',
                           'completed', 'starsEarned', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidRoutineLog(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidRoutineLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().routineId == existing().routineId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'completed', 'starsEarned', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      match /lessonProgress/{lessonDocId} {
        allow get: if isOwner(userId) && isValidId(lessonDocId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(lessonDocId) &&
                         incoming().keys().hasAll([
                           'userId', 'subjectId', 'lessonId', 'completed',
                           'bestScore', 'totalQuestions', 'starsEarned',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'subjectId', 'lessonId', 'completed',
                           'bestScore', 'totalQuestions', 'starsEarned',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidLessonProgress(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(lessonDocId) &&
                         isValidLessonProgress(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().subjectId == existing().subjectId &&
                         incoming().lessonId == existing().lessonId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'completed', 'bestScore', 'totalQuestions', 'starsEarned', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(lessonDocId);
      }
    }
  }
}
